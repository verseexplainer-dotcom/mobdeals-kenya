---
import Container from '@components/ui/Container.astro';
import type { BrandItem } from '@data/homepage';

interface Props {
  brands: BrandItem[];
}

const { brands } = Astro.props;
---

<section class="border-y border-ses-line bg-surface-container-low" aria-labelledby="featured-brands-title" data-home-reveal>
  <Container size="xl" class="py-10 sm:py-12">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-label-xs uppercase text-ses-accent">Featured Brands</p>
        <h2 id="featured-brands-title" class="mt-3 text-headline-lg font-display text-on-surface">
          Shop by Brand
        </h2>
      </div>
      <a href="/brands" class="text-label-md text-on-surface hover:text-ses-accent">View all brands</a>
    </div>

    <div class="-mx-[var(--spacing-page)] mt-8 flex snap-x overflow-x-auto px-[var(--spacing-page)] pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-5 md:overflow-visible md:px-0 [&::-webkit-scrollbar]:hidden">
      {brands.map((brand) => (
        <a href={brand.href} class="group flex min-w-[12rem] snap-start items-center justify-center border-r border-ses-line px-6 py-8 text-center transition-colors hover:bg-white/[0.04] md:min-w-0 first:border-l">
          <span>
            <span class="block text-headline-lg font-display text-on-surface transition-colors group-hover:text-tertiary">{brand.name}</span>
            <span class="mt-2 block text-body-sm text-on-surface-variant">{brand.note}</span>
          </span>
        </a>
      ))}
    </div>
  </Container>
</section>
