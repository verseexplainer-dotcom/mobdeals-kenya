---
import Breadcrumbs from '@components/navigation/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import Section from '@components/ui/Section.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { siteConfig } from '@config/site';

const deliveryMessage = encodeURIComponent('Hello MobDeals Kenya, please confirm delivery options for this product/order:');
const deliverySections = [
  ['Nairobi Store Pickup', 'Collect confirmed orders from our Nairobi CBD store.'],
  ['Nairobi Delivery', 'Rider delivery can be arranged depending on your location, order and delivery time.'],
  ['Countrywide Delivery', 'Orders outside Nairobi can be sent using available courier services after payment and delivery details are confirmed.'],
  ['Delivery Charges', 'Delivery charges depend on destination and package size and are confirmed before dispatch.'],
  ['Before Dispatch', 'We confirm the product, receiver details, destination and delivery charges before dispatch.']
];
---

<BaseLayout seo={{ title: 'Delivery Across Kenya', description: 'Choose Nairobi pickup, local delivery or countrywide delivery after confirming your MobDeals order.', pathname: '/delivery' }}>
  <Section class="bg-surface-container-low/40" containerSize="xl" spacing="sm">
    <Breadcrumbs items={[{ label: 'Delivery' }]} />
    <div class="mt-8 max-w-4xl">
      <Badge variant="accent" size="md">DELIVERY & PICKUP</Badge>
      <h1 class="mt-5 font-display text-display-lg-mobile text-on-surface sm:text-headline-xl">Delivery Across Kenya</h1>
      <p class="mt-5 max-w-3xl text-body-lg text-on-surface-variant">Choose Nairobi pickup, local delivery or countrywide delivery after confirming your order.</p>
    </div>
  </Section>

  <Section containerSize="xl" spacing="sm">
    <div class="divide-y divide-ses-line border-y border-ses-line">
      {deliverySections.map(([title, text]) => (
        <article class="grid gap-3 py-6 md:grid-cols-[0.55fr_1fr] md:gap-8">
          <h2 class="text-title-md text-on-surface">{title}</h2>
          <p class="text-body-md text-on-surface-variant">{text}</p>
        </article>
      ))}
    </div>
    <Button href={`https://wa.me/${siteConfig.whatsappNumber}?text=${deliveryMessage}`} target="_blank" variant="whatsapp" class="mt-8">CONFIRM DELIVERY ON WHATSAPP</Button>
  </Section>
</BaseLayout>
