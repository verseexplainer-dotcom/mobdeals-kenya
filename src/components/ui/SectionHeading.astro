---
import Heading from './Heading.astro';

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  size?: 'md' | 'lg' | 'xl';
  class?: string;
}

const { id, eyebrow, title, description, align = 'left', size = 'lg', class: className } = Astro.props;
---

<Heading id={id} as="h2" eyebrow={eyebrow} description={description} align={align} size={size} class={className}>
  {title}
</Heading>
