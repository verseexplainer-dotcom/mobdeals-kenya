---
import Container from '@components/ui/Container.astro';
import type { TrustItem } from '@data/homepage';

interface Props {
  items: TrustItem[];
}

const { items } = Astro.props;
---

<section class="bg-[#0f766e] text-white" aria-labelledby="trust-bar-title">
  <Container size="xl" class="py-8 sm:py-10">
    <h2 id="trust-bar-title" class="sr-only">Store trust signals</h2>
    <div class="grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-0" data-home-reveal>
      {items.map((item, index) => (
        <article class={`min-w-0 rounded-2xl border border-white/20 bg-white/5 p-3 sm:p-5 lg:rounded-none lg:border-0 lg:bg-transparent lg:py-0 ${index > 0 ? 'lg:border-l lg:border-white/20' : ''}`}>
          <p class="text-label-xs uppercase tracking-[0.12em] text-[#ffd0ad]">{item.label}</p>
          <h3 class="mt-3 font-display text-base leading-snug font-semibold text-white sm:text-xl">{item.title}</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-white/75 sm:text-sm sm:leading-6">{item.description}</p>
        </article>
      ))}
    </div>
  </Container>
</section>
