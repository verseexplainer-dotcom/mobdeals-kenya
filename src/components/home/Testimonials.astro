---
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import type { TestimonialItem } from '@data/homepage';

interface Props {
  testimonials: TestimonialItem[];
}

const { testimonials } = Astro.props;
---

<Section class="bg-surface-container-low" containerSize="xl" ariaLabelledby="testimonials-title">
  <SectionHeading
    id="testimonials-title"
    eyebrow="Customer trust"
    title="Clear guidance for everyday tech decisions."
    description="Shoppers and office buyers come to SES for practical recommendations, clear specs, and local support."
  />

  <div class="mt-10 grid gap-4 md:grid-cols-3">
    {testimonials.map((testimonial) => (
      <figure class="flex min-h-72 flex-col rounded-card border border-ses-line bg-surface-container-lowest p-5 shadow-sm sm:p-6">
        <blockquote class="text-body-md text-on-surface">
          "{testimonial.quote}"
        </blockquote>
        <figcaption class="mt-auto pt-8">
          <p class="text-label-md text-on-surface">{testimonial.name}</p>
          <p class="mt-1 text-body-sm text-on-surface-variant">{testimonial.detail}</p>
        </figcaption>
      </figure>
    ))}
  </div>
</Section>
