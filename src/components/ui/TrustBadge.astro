---
import { classNames } from '@lib/utils/classNames';

interface Props {
  title: string;
  description?: string;
  icon?: string;
  class?: string;
}

const { title, description, icon, class: className } = Astro.props;
---

<div class={classNames('flex items-start gap-3 rounded-card border border-ses-line bg-surface-container-lowest p-4 shadow-xs', className)}>
  {icon && (
    <span class="flex size-10 shrink-0 items-center justify-center rounded-pill bg-primary-fixed text-label-md text-on-primary-fixed-variant" aria-hidden="true">
      {icon}
    </span>
  )}
  <div class="min-w-0">
    <p class="text-label-md text-on-surface">{title}</p>
    {description && <p class="mt-1 text-body-sm text-on-surface-variant">{description}</p>}
  </div>
</div>
