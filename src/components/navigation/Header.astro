---
import { primaryNavigation, supportNavigation } from '@config/navigation';
import { siteConfig } from '@config/site';
import Container from '@components/ui/Container.astro';
import MegaMenu from './MegaMenu.astro';
import MobileMenu from './MobileMenu.astro';
import SearchBar from './SearchBar.astro';
---

<header class="sticky top-0 z-40 border-b border-ses-line bg-background/90 backdrop-blur">
  <div class="hidden border-b border-ses-line bg-primary text-on-primary md:block">
    <Container size="xl" class="flex min-h-9 items-center justify-between gap-4 text-label-xs">
      <p>Fast delivery in Nairobi. Business supply available across Kenya.</p>
      <nav aria-label="Support links" class="flex items-center gap-4">
        {supportNavigation.map((item) => (
          <a href={item.href} class="text-white/80 transition duration-200 hover:text-white">
            {item.label}
          </a>
        ))}
      </nav>
    </Container>
  </div>

  <Container size="xl" class="flex min-h-16 items-center gap-4">
    <MobileMenu />

    <a href="/" class="flex shrink-0 items-center gap-2 rounded-pill focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ses-accent" aria-label={`${siteConfig.name} home`}>
      <span class="flex size-9 items-center justify-center rounded-pill bg-primary text-label-md text-on-primary">SN</span>
      <span class="hidden text-label-md text-on-surface sm:inline">{siteConfig.name}</span>
    </a>

    <nav aria-label="Primary navigation" class="hidden items-center gap-1 lg:flex">
      <MegaMenu />
      {primaryNavigation.slice(0, 4).map((item) => (
        <a href={item.href} class="rounded-pill px-3 py-2 text-label-md text-on-surface transition duration-200 hover:bg-surface-container-low hover:text-ses-accent">
          {item.label}
        </a>
      ))}
    </nav>

    <SearchBar class="ml-auto hidden max-w-sm md:block xl:max-w-md" />

    <div class="ml-auto flex items-center gap-2 md:ml-0">
      <a href="/contact" class="hidden rounded-pill border border-ses-line bg-surface-container-lowest px-4 py-2 text-label-md text-on-surface shadow-xs transition duration-200 hover:border-primary-fixed-dim hover:text-ses-accent sm:inline-flex">
        Contact
      </a>
      <a href="/shop" class="rounded-pill bg-ses-accent px-4 py-2 text-label-md text-white shadow-xs transition duration-200 hover:bg-ses-accent-dark hover:shadow-soft">
        Shop
      </a>
    </div>
  </Container>
</header>
