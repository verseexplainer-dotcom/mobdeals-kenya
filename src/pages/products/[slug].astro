---
import ProductGallery from '@components/product/ProductGallery.astro';
import ProductSpecsTable from '@components/product/ProductSpecsTable.astro';
import RelatedProducts from '@components/product/RelatedProducts.astro';
import Breadcrumbs from '@components/navigation/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import Section from '@components/ui/Section.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getAllProducts, getCategoryBySlug, getRelatedProducts } from '@data/products';
import { siteConfig } from '@config/site';
import { formatProductPrice, getProductDisplaySpecs, getProductDisplaySummary } from '@lib/products';
import { absoluteUrl, createBreadcrumbSchema, createProductSchema, createProductSeo, stringifyJsonLd } from '@lib/seo';

export function getStaticPaths() {
  return getAllProducts().map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;
const category = getCategoryBySlug(product.category);
const relatedProducts = getRelatedProducts(product);
const displaySpecs = getProductDisplaySpecs(product);
const productSummary = getProductDisplaySummary(product);
const productUrl = absoluteUrl(`/products/${product.slug}`) ?? `/products/${product.slug}`;
const whatsappMessage = encodeURIComponent(`Hi MobDeals Kenya, I would like to order ${product.name} (${formatProductPrice(product.price)}). Product link: ${productUrl}`);
const whatsappHref = `https://wa.me/${siteConfig.whatsappNumber}?text=${whatsappMessage}`;
const cartProduct = {
  id: product.id,
  slug: product.slug,
  name: product.name,
  brand: product.brand,
  category: product.category,
  price: product.price,
  image: product.images[0]?.src
};
const productSchema = stringifyJsonLd(createProductSchema(product));
const breadcrumbSchema = stringifyJsonLd(createBreadcrumbSchema([
  { label: 'Home', href: '/' },
  { label: 'Shop', href: '/shop' },
  { label: category?.label ?? product.category, href: `/category/${product.category}` },
  { label: product.name, href: `/products/${product.slug}` }
]));
---

<BaseLayout seo={createProductSeo(product)} mainClass="pb-20 lg:pb-0">
  <script is:inline slot="head" type="application/ld+json" set:html={productSchema} />
  <script is:inline slot="head" type="application/ld+json" set:html={breadcrumbSchema} />

  <Section class="bg-surface-container-low/35" containerSize="xl" spacing="sm">
    <Breadcrumbs items={[{ label: 'Shop', href: '/shop' }, { label: category?.label ?? product.category, href: `/category/${product.category}` }, { label: product.name }]} />
    <div class="mt-8 grid gap-9 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      <ProductGallery product={product} />

      <div class="lg:sticky lg:top-28">
        <div class="flex flex-wrap items-center gap-2">
          {product.brand && <Badge variant="neutral" size="md">{product.brand}</Badge>}
          <Badge variant="primary" size="md">{product.condition}</Badge>
          <Badge variant={product.inStock ? 'success' : 'neutral'} size="md">{product.inStock ? 'In stock' : 'Check availability'}</Badge>
        </div>

        <h1 class="mt-5 font-display text-display-lg-mobile text-on-surface sm:text-headline-xl lg:text-[2.75rem] lg:leading-[1.1]">{product.name}</h1>

        <div class="mt-7 border-y border-ses-line py-5">
          <p class="text-label-xs uppercase text-ses-accent">Price</p>
          <p class="mt-2 font-display text-headline-xl text-on-surface">{formatProductPrice(product.price)}</p>
          {product.price.compareAtAmount && (
            <p class="text-body-sm text-on-surface-variant line-through">{formatProductPrice({ amount: product.price.compareAtAmount, currency: product.price.currency })}</p>
          )}
          <p class="mt-3 text-body-sm text-on-surface-variant">{product.availabilityNote}</p>
        </div>

        <ul class="mt-6 grid gap-px overflow-hidden rounded-card border border-ses-line bg-ses-line sm:grid-cols-2" aria-label="Purchase support">
          {['Warranty information available', 'Nairobi pickup available', 'Countrywide delivery', 'WhatsApp support'].map((item) => (
            <li class="flex min-h-12 items-center gap-2 bg-surface-container-lowest px-3 text-body-sm text-on-surface">
              <span class="size-2 shrink-0 rounded-full bg-secondary" aria-hidden="true"></span>{item}
            </li>
          ))}
        </ul>

        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <button type="button" class="inline-flex min-h-12 w-full items-center justify-center rounded-control bg-primary px-6 text-body-md font-semibold text-on-primary transition hover:-translate-y-0.5 hover:bg-primary-container" data-cart-add data-cart-product={JSON.stringify(cartProduct)} aria-label={`Add ${product.name} to cart`}>
            ADD TO CART
          </button>
          <Button href={whatsappHref} variant="whatsapp" size="lg" target="_blank" class="w-full">ORDER ON WHATSAPP</Button>
        </div>
        <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-body-sm text-on-surface-variant">
          <a href="/cart" class="hover:text-ses-accent">View cart</a>
          <a href="/contact" class="hover:text-ses-accent">Talk to support</a>
        </div>
      </div>
    </div>
  </Section>

  <Section containerSize="xl" spacing="sm" ariaLabelledby="key-specifications-title">
    <div class="grid gap-8 lg:grid-cols-[0.7fr_1fr]">
      <div>
        <p class="text-label-xs uppercase text-ses-accent">Product Information</p>
        <h2 id="key-specifications-title" class="mt-3 font-display text-headline-lg text-on-surface">Key Specifications</h2>
      </div>
      <ProductSpecsTable specs={displaySpecs} />
    </div>
  </Section>

  <Section class="bg-surface-container-low/35" containerSize="xl" spacing="sm" ariaLabel="Product information">
    <div class="divide-y divide-ses-line border-y border-ses-line">
      <article class="grid gap-3 py-6 md:grid-cols-[0.55fr_1fr] md:gap-8">
        <h2 class="text-title-md text-on-surface">Product Details</h2>
        <p class="text-body-md text-on-surface-variant">{productSummary}</p>
      </article>
      <article class="grid gap-3 py-6 md:grid-cols-[0.55fr_1fr] md:gap-8">
        <h2 class="text-title-md text-on-surface">Condition & Warranty</h2>
        <p class="text-body-md text-on-surface-variant">Condition: {product.condition}. Warranty: {product.warranty}. Confirm the applicable terms before payment.</p>
      </article>
      <article class="grid gap-3 py-6 md:grid-cols-[0.55fr_1fr] md:gap-8">
        <h2 class="text-title-md text-on-surface">Delivery & Pickup</h2>
        <p class="text-body-md text-on-surface-variant">Nairobi store pickup, local delivery and countrywide delivery can be arranged after the order and destination are confirmed.</p>
      </article>
    </div>
  </Section>

  <RelatedProducts products={relatedProducts} />

  <div class="fixed inset-x-0 bottom-0 z-40 border-t border-ses-line bg-background/96 px-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] pt-3 shadow-ambient backdrop-blur lg:hidden" aria-label="Mobile purchase actions">
    <div class="mx-auto grid w-full max-w-[32rem] grid-cols-2 gap-2">
      <button type="button" class="inline-flex min-h-12 min-w-0 items-center justify-center whitespace-nowrap rounded-control bg-primary px-2 text-[0.72rem] font-semibold text-on-primary sm:px-3 sm:text-label-md" data-cart-add data-cart-product={JSON.stringify(cartProduct)} aria-label={`Add ${product.name} to cart`}>
        ADD TO CART
      </button>
      <a href={whatsappHref} target="_blank" rel="noreferrer" class="inline-flex min-h-12 min-w-0 items-center justify-center whitespace-nowrap rounded-control bg-whatsapp px-2 text-center text-[0.72rem] font-semibold text-on-secondary sm:px-3 sm:text-label-md">
        ORDER ON WHATSAPP
      </a>
    </div>
  </div>
</BaseLayout>
