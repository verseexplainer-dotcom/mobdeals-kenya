---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

{items.length > 0 && (
  <nav aria-label="Breadcrumb" class:list={['text-body-sm text-on-surface-variant', className]}>
    <ol class="flex flex-wrap items-center gap-2" itemscope itemtype="https://schema.org/BreadcrumbList">
      <li>
        <a href="/" class="hover:text-ses-accent">Home</a>
      </li>
      {items.map((item, index) => (
        <li class="flex items-center gap-2" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span aria-hidden="true">›</span>
          {item.href && index < items.length - 1 ? (
            <a href={item.href} class="hover:text-ses-accent" itemprop="item">
              <span itemprop="name">{item.label}</span>
            </a>
          ) : (
            <span aria-current="page" class="text-on-surface" itemprop="name">{item.label}</span>
          )}
          <meta itemprop="position" content={String(index + 2)} />
        </li>
      ))}
    </ol>
  </nav>
)}
