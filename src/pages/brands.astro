---
import ProductCard from '@components/product/ProductCard.astro';
import Breadcrumbs from '@components/navigation/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import Grid from '@components/ui/Grid.astro';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getAllProducts } from '@data/products';
import { brandProfiles } from '@data/support';

const products = getAllProducts();
const featuredProducts = products.filter((product) => product.featured).slice(0, 4);
---

<BaseLayout
  seo={{
    title: 'Electronics Brands in Nairobi',
    description: 'Browse current MobDeals Kenya brand listings generated from the product workbook, including HP, Lenovo, Dell, Epson, Samsung, Apple, Starlink, and more.',
    pathname: '/brands'
  }}
>
  <Section class="bg-surface-container-low/40" containerSize="xl" spacing="sm">
    <Breadcrumbs items={[{ label: 'Brands' }]} />
    <div class="mt-10 max-w-4xl">
      <Badge variant="accent" size="md">Featured brands</Badge>
      <h1 class="mt-5 font-display text-display-lg-mobile text-on-surface sm:text-headline-xl">
        Compare brands by real buying use.
      </h1>
      <p class="mt-5 max-w-2xl text-body-lg text-on-surface-variant">
        Start with the brand, then narrow by category, condition, price, visible specs, and availability.
      </p>
    </div>
  </Section>

  <Section containerSize="xl" spacing="sm" ariaLabelledby="brands-title">
    <SectionHeading id="brands-title" eyebrow="Brand index" title="Current buying paths" />
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {brandProfiles.map((brand) => (
        <a href={`/brands/${brand.slug}`} class="group rounded-card border border-ses-line bg-surface-container-lowest p-5 transition hover:-translate-y-0.5 hover:border-primary-fixed-dim">
          <p class="text-label-xs uppercase text-ses-accent">{brand.categories.join(' / ')}</p>
          <h2 class="mt-3 text-title-lg text-on-surface group-hover:text-ses-accent">{brand.name}</h2>
          <p class="mt-3 text-body-sm text-on-surface-variant">{brand.summary}</p>
        </a>
      ))}
    </div>
  </Section>

  <Section class="bg-surface-container-low/35" containerSize="xl" spacing="sm">
    <SectionHeading eyebrow="Featured products" title="Available brand-led options" />
    <Grid columns="products" gap="md" class="mt-8">
      {featuredProducts.map((product) => <ProductCard product={product} />)}
    </Grid>
  </Section>
</BaseLayout>
