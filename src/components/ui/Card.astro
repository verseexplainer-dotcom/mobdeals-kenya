---
import { classNames } from '@lib/utils/classNames';

interface Props {
  as?: keyof HTMLElementTagNameMap;
  class?: string;
  interactive?: boolean;
  padding?: 'none' | 'sm' | 'md' | 'lg';
  variant?: 'default' | 'soft' | 'outlined';
}

const {
  as: Tag = 'article',
  class: className,
  interactive = false,
  padding = 'md',
  variant = 'default'
}: Props = Astro.props;

const paddingClasses: Record<NonNullable<Props['padding']>, string> = {
  none: '',
  sm: 'p-4',
  md: 'p-5 sm:p-6',
  lg: 'p-6 sm:p-8'
};
const paddingClass = paddingClasses[padding];

const variantClasses: Record<NonNullable<Props['variant']>, string> = {
  default: interactive ? 'premium-card-interactive' : 'premium-card',
  soft: 'rounded-card border border-ses-line bg-surface-container-low',
  outlined: 'rounded-card border border-ses-line bg-transparent'
};
const variantClass = variantClasses[variant];
---

<Tag class={classNames(variantClass, paddingClass, className)}>
  <slot />
</Tag>
