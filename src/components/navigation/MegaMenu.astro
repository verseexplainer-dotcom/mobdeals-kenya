---
import { categoryNavigation } from '@config/navigation';
---

<details class="group relative hidden lg:block">
  <summary class="flex cursor-pointer list-none items-center gap-1 rounded-pill px-3 py-2 text-label-md text-on-surface transition duration-200 hover:bg-surface-container-low hover:text-ses-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ses-accent">
    Shop
    <span class="text-body-sm transition duration-200 group-open:rotate-180" aria-hidden="true">⌄</span>
  </summary>

  <div class="absolute left-0 top-full z-50 mt-3 w-[min(72rem,calc(100vw-2rem))] rounded-card-lg border border-ses-line bg-surface-container-lowest p-6 shadow-ambient">
    <div class="grid gap-5 lg:grid-cols-[1.1fr_2fr]">
      <div class="rounded-card bg-primary p-6 text-on-primary">
        <p class="text-label-xs uppercase text-white/70">SES NEXT GEN</p>
        <h2 class="mt-4 text-headline-xl">Premium tech for Kenya.</h2>
        <p class="mt-3 text-body-sm text-white/75">
          Shop reliable laptops, phones, printers, desktops, and storage for work, study, and business.
        </p>
        <a href="/shop" class="mt-6 inline-flex rounded-control bg-white px-4 py-2 text-label-md text-primary transition duration-200 hover:bg-primary-fixed">
          Shop all products
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {categoryNavigation.map((category) => (
          <section class="rounded-card border border-ses-line bg-surface-container-lowest p-4 transition duration-200 hover:border-primary-fixed-dim hover:shadow-soft">
            <a href={category.href} class="text-headline-sm text-on-surface transition duration-200 hover:text-ses-accent">
              {category.label}
            </a>
            {category.description && <p class="mt-2 text-body-sm text-on-surface-variant">{category.description}</p>}
            {category.links && (
              <ul class="mt-4 grid gap-2">
                {category.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-body-sm text-on-surface-variant transition duration-200 hover:text-ses-accent">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
    </div>
  </div>
</details>
