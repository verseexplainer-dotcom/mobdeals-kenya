---
import ProductCard from '@components/product/ProductCard.astro';
import Badge from '@components/ui/Badge.astro';
import Grid from '@components/ui/Grid.astro';
import Section from '@components/ui/Section.astro';
import type { ProductSummary } from '@lib/products';

interface Props {
  products: ProductSummary[];
}

const { products } = Astro.props;
---

<Section class="bg-[#eef1eb]" containerSize="xl" ariaLabelledby="featured-products-title">
  <div data-home-reveal>
  <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-label-xs uppercase tracking-[0.12em] text-[#b95716]">Featured products</p>
      <h2 id="featured-products-title" class="mt-3 font-display text-headline-xl font-bold text-[#102a2a] sm:text-display-lg-mobile">Top picks for you</h2>
      <p class="mt-4 max-w-[42rem] text-body-md text-[#49615c]">Explore popular devices from the MobDeals catalogue, with clear details and support when you need it.</p>
    </div>
    <Badge variant="primary" size="md">Popular</Badge>
  </div>

  <Grid columns="four" gap="md" class="mt-10">
    {products.map((product, index) => (
      <ProductCard
        product={product}
        ctaLabel="View product"
        priority={index < 2}
      />
    ))}
  </Grid>
  <div class="mt-10 flex justify-center">
    <a href="/shop" class="inline-flex min-h-11 items-center gap-2 rounded-pill border border-[#b8cec6] bg-white/60 px-5 text-label-md text-[#16423d] transition-colors hover:border-[#f97316] hover:text-[#b95716]">
      View the full catalogue <span aria-hidden="true">→</span>
    </a>
  </div>
  </div>
</Section>
