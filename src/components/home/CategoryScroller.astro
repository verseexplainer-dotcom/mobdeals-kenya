---
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import type { HomeCategory } from '@data/homepage';

interface Props {
  categories: HomeCategory[];
}

const { categories } = Astro.props;
---

<Section id="categories" containerSize="xl" ariaLabelledby="categories-title" containerClass="relative">
  <div data-home-reveal>
    <SectionHeading id="categories-title" eyebrow="Browse the catalogue" title="Start With What You Need" description="Real stock for work, school, business and home—organised so you can get to the right shortlist quickly." />

    <div class="-mx-[var(--spacing-page)] mt-10 flex snap-x gap-4 overflow-x-auto px-[var(--spacing-page)] pb-4 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:overflow-visible md:px-0 xl:grid-cols-4 [&::-webkit-scrollbar]:hidden">
      {categories.map((category) => (
      <a href={category.href} class="group flex min-w-[17rem] snap-start flex-col overflow-hidden rounded-card border border-ses-line bg-surface-container-lowest shadow-sm transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-1 hover:border-primary-fixed-dim hover:shadow-soft md:min-w-0">
        <div class="relative flex h-48 items-center justify-center overflow-hidden bg-surface p-5">
          <div class="absolute inset-x-8 bottom-3 h-10 rounded-full bg-black/35 blur-xl" aria-hidden="true"></div>
          <img
            src={category.image.src}
            srcset={`${category.image.src.replace('.webp', '-400.webp')} 400w, ${category.image.src} 800w`}
            sizes="(max-width: 768px) 272px, (max-width: 1280px) 50vw, 320px"
            alt={category.image.alt}
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
            class="relative size-full object-contain transition-transform duration-500 ease-standard group-hover:scale-[1.04]"
          />
        </div>
        <div class="flex flex-1 flex-col p-5">
          <p class="text-label-xs uppercase text-ses-accent">{category.meta}</p>
          <h3 class="mt-3 text-title-md text-on-surface">{category.label}</h3>
          <p class="mt-3 text-body-sm text-on-surface-variant">{category.description}</p>
          <span class="mt-auto flex items-center gap-2 pt-6 text-label-md text-on-surface transition-colors group-hover:text-tertiary">
            Shop {category.label} <span aria-hidden="true">→</span>
          </span>
        </div>
      </a>
      ))}
    </div>
  </div>
</Section>
