---
import ProductImage from './ProductImage.astro';
import { usableProductImages } from '@lib/products/images';
import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import { formatProductPrice, type ProductSummary } from '@lib/products';
import { classNames } from '@lib/utils/classNames';

interface Props {
  product: ProductSummary;
  href?: string;
  class?: string;
  ctaLabel?: string;
  priority?: boolean;
}

const { product, href, class: className, ctaLabel = 'View product', priority = false } = Astro.props;
const image = usableProductImages(product.images)[0];
const productHref = href ?? `/products/${product.slug}`;
const visibleSpecs = (product.specs ?? [])
  .filter((spec) => ['Processor', 'Memory', 'Storage', 'Display'].includes(spec.label))
  .slice(0, 2);

const compareAt = product.price.compareAtAmount;
const currentAmount = product.price.amount;
const discountPercent =
  compareAt && compareAt > currentAmount
    ? Math.round((1 - currentAmount / compareAt) * 100)
    : null;

---

<article class={classNames('product-card premium-card flex h-full min-w-0 flex-col overflow-hidden', className)}>
  <a href={productHref} class="relative block bg-surface-container-low p-1.5 sm:p-2" aria-label={`View ${product.name}`}>
    {discountPercent !== null && (
      <span class="absolute left-3.5 top-3.5 z-10 rounded-pill bg-error px-2 py-0.5 text-label-xs font-semibold text-on-error shadow-xs">
        -{discountPercent}%
      </span>
    )}
    <div class="aspect-square overflow-hidden rounded-card bg-surface-container-lowest">
      <ProductImage image={image} category={product.category} priority={priority} />
    </div>
  </a>

  <div class="flex min-w-0 flex-1 flex-col p-3 sm:p-4">
    <div class="flex flex-wrap items-center gap-1.5">
      <Badge class="product-card-badge" variant={product.inStock ? 'success' : 'neutral'}>{product.inStock ? 'In stock' : 'Check availability'}</Badge>
      {product.featured && <Badge class="product-card-badge" variant="primary">Featured</Badge>}
      {product.condition && <Badge class="product-card-badge" variant="neutral">{product.condition === 'Refurbished' ? 'Ex-UK' : product.condition}</Badge>}
    </div>

    <h3 class="mt-2.5 line-clamp-3 text-sm leading-snug font-bold wrap-anywhere text-on-surface sm:text-title-sm">
      <a href={productHref} class="hover:text-ses-accent">{product.name}</a>
    </h3>

    {product.brand && <p class="mt-1 text-xs wrap-anywhere text-on-surface-variant sm:text-body-sm">{product.brand}</p>}

    {visibleSpecs.length > 0 && (
      <dl class="mt-3 hidden gap-1.5 border-t border-ses-line pt-3 sm:grid">
        {visibleSpecs.map((spec) => (
          <div class="flex items-start justify-between gap-2 text-xs sm:text-body-sm">
            <dt class="shrink-0 text-on-surface-variant">{spec.label}</dt>
            <dd class="min-w-0 text-right wrap-anywhere text-on-surface">{spec.value}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="mt-auto pt-3">
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
        <p class="text-base leading-snug font-bold wrap-anywhere text-on-surface sm:text-xl">{formatProductPrice(product.price)}</p>
        {product.price.compareAtAmount && (
          <p class="text-xs wrap-anywhere text-on-surface-variant line-through sm:text-body-sm">
            {formatProductPrice({ amount: product.price.compareAtAmount, currency: product.price.currency })}
          </p>
        )}
      </div>
    </div>

    <div class="mt-3">
      <Button href={productHref} variant="primary" size="sm" class="product-card-cta w-full" ariaLabel={`View ${product.name}`}>
        {ctaLabel}
      </Button>
    </div>
  </div>
</article>

<style>
  .product-card :global(.product-card-badge) {
    max-width: 100%;
    padding-inline: 0.5rem;
    font-size: 0.6875rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .product-card :global(.product-card-cta) {
    min-height: 2.75rem;
    padding: 0.5rem;
    font-size: 0.75rem;
    line-height: 1.4;
    text-align: center;
    overflow-wrap: anywhere;
  }

  @media (min-width: 40rem) {
    .product-card :global(.product-card-badge) {
      font-size: 0.75rem;
    }

    .product-card :global(.product-card-cta) {
      font-size: 0.875rem;
    }
  }
</style>
