---
import { categoryNavigation, quickNavigation, supportNavigation } from '@config/navigation';
import { siteConfig } from '@config/site';
import SearchBar from './SearchBar.astro';
---

<details class="group xl:hidden" data-mobile-menu>
  <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-control border border-ses-line bg-surface-container-lowest text-on-surface shadow-xs hover:bg-surface-container-low focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ses-accent" aria-label="Open menu" aria-controls="mobile-menu-panel" aria-expanded="false" data-mobile-menu-toggle>
    <span class="text-headline-sm group-open:hidden" aria-hidden="true">☰</span>
    <span class="hidden text-headline-sm group-open:inline" aria-hidden="true">×</span>
  </summary>

  <div id="mobile-menu-panel" class="fixed inset-x-0 top-[6.75rem] z-50 max-h-[calc(100svh-6.75rem)] overflow-y-auto border-y border-ses-line bg-background/98 p-4 shadow-ambient backdrop-blur sm:px-6">
    <SearchBar id="mobile-search" placeholder="Search laptops, printers, monitors and more" />

    <nav aria-label="Mobile quick links" class="mt-4 grid grid-cols-2 gap-2">
      {quickNavigation.map((item) => (
        <a href={item.href} class="rounded-card border border-ses-line bg-surface-container-lowest px-3 py-3 text-body-sm text-on-surface hover:border-primary-fixed-dim hover:text-ses-accent">
          {item.label}
        </a>
      ))}
    </nav>

    <nav aria-label="Mobile product categories" class="mt-5">
      <p class="px-1 text-label-xs uppercase text-on-surface-variant">Shop by category</p>
      <div class="mt-3 grid gap-2">
        {categoryNavigation.map((category) => (
          <details class="rounded-card border border-ses-line bg-surface-container-lowest p-3">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-label-md text-on-surface">
              <span>{category.label}</span>
              <span class="text-body-sm" aria-hidden="true">⌄</span>
            </summary>
            <ul class="mt-3 grid gap-1 border-t border-ses-line pt-3">
              <li>
                <a href={category.href} class="block rounded-control px-3 py-2.5 text-body-sm font-semibold text-on-surface hover:bg-surface-container-low hover:text-ses-accent">
                  Shop all {category.label}
                </a>
              </li>
              {category.links?.map((link) => (
                <li>
                  <a href={link.href} class="block rounded-control px-3 py-2.5 text-body-sm text-on-surface-variant hover:bg-surface-container-low hover:text-ses-accent">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </nav>

    <nav aria-label="Mobile support" class="mt-6 border-t border-ses-line pt-5">
      <p class="px-1 text-label-xs uppercase text-on-surface-variant">Support</p>
      <div class="mt-3 grid grid-cols-2 gap-2">
        {supportNavigation.map((item) => (
          <a href={item.href} class="rounded-card border border-ses-line bg-surface-container-lowest px-3 py-3 text-body-sm text-on-surface hover:border-primary-fixed-dim hover:text-ses-accent">
            {item.label}
          </a>
        ))}
      </div>
    </nav>

    <a href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hello MobDeals Kenya, I need help choosing a product.')}`} target="_blank" rel="noreferrer" class="mt-5 flex min-h-12 items-center justify-center rounded-control bg-whatsapp px-5 text-label-md text-on-secondary hover:bg-whatsapp-dark">
      WhatsApp Us
    </a>
  </div>
</details>

<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  const mobileMenuToggle = mobileMenu?.querySelector<HTMLElement>('[data-mobile-menu-toggle]');

  const updateMobileMenuState = () => {
    if (!mobileMenu || !mobileMenuToggle) return;
    mobileMenuToggle.setAttribute('aria-expanded', String(mobileMenu.open));
    mobileMenuToggle.setAttribute('aria-label', mobileMenu.open ? 'Close menu' : 'Open menu');
  };

  mobileMenu?.addEventListener('toggle', updateMobileMenuState);
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.open = false;
      updateMobileMenuState();
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenu?.open) {
      mobileMenu.open = false;
      updateMobileMenuState();
      mobileMenuToggle?.focus();
    }
  });
  updateMobileMenuState();
</script>
