---
import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import { formatProductPrice, type ProductSummary } from '@lib/products';
import { classNames } from '@lib/utils/classNames';

interface Props {
  product: ProductSummary;
  href?: string;
  class?: string;
  ctaLabel?: string;
  priority?: boolean;
}

const { product, href, class: className, ctaLabel = 'View product', priority = false } = Astro.props;
const image = product.images[0];
const productHref = href ?? `/products/${product.slug}`;
const productSummary = {
  id: product.id,
  slug: product.slug,
  name: product.name,
  brand: product.brand,
  category: product.category,
  price: product.price,
  image: image?.src
};
const visibleSpecs = (product.specs ?? [])
  .filter((spec) => ['Processor', 'Memory', 'Storage', 'Display'].includes(spec.label))
  .slice(0, 3);
const categoryLabel = product.category
  .replace(/-/g, ' ')
  .replace(/\b\w/g, (character) => character.toUpperCase());
const categoryKey = product.category.toLowerCase();

let fallbackTone = 'bg-primary text-on-primary';
if (categoryKey.includes('smartphone') || categoryKey.includes('internet')) {
  fallbackTone = 'bg-secondary text-on-secondary';
} else if (categoryKey.includes('printer') || categoryKey.includes('projector')) {
  fallbackTone = 'bg-tertiary text-on-tertiary';
} else if (categoryKey.includes('storage')) {
  fallbackTone = 'bg-surface-container-high text-on-surface';
}
---

<article class={classNames('premium-card flex h-full flex-col overflow-hidden', className)}>
  <a href={productHref} class="block bg-surface-container-low p-2.5 sm:p-3" aria-label={`View ${product.name}`}>
    <div class="aspect-square overflow-hidden rounded-card bg-surface-container-lowest">
      {image ? (
        <img
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          class="size-full object-contain p-3 sm:p-4"
        />
      ) : (
        <div class={`flex size-full items-center justify-center overflow-hidden ${fallbackTone}`} aria-hidden="true">
          {categoryKey.includes('smartphone') && (
            <div class="h-[72%] w-[38%] rounded-[1.4rem] border-[7px] border-current bg-white/15 shadow-soft"></div>
          )}
          {categoryKey.includes('printer') && (
            <div class="w-[68%]">
              <div class="mx-auto h-8 w-3/4 rounded-t-md bg-current/20"></div>
              <div class="rounded-card border-[6px] border-current bg-white/15 p-4">
                <div class="h-3 w-20 rounded-pill bg-current/30"></div>
                <div class="mt-8 h-16 rounded-md bg-current/10"></div>
              </div>
            </div>
          )}
          {categoryKey.includes('desktop') && (
            <div class="flex items-end gap-3">
              <div class="h-28 w-36 rounded-md border-[7px] border-current bg-white/10"></div>
              <div class="h-32 w-12 rounded-md bg-current/20"></div>
            </div>
          )}
          {categoryKey.includes('storage') && (
            <div class="grid grid-cols-2 gap-3">
              <div class="h-28 w-16 rounded-md border-[6px] border-current bg-white/20"></div>
              <div class="mt-8 h-20 w-16 rounded-md bg-current/20"></div>
            </div>
          )}
          {categoryKey.includes('monitor') && (
            <div class="w-[72%]">
              <div class="aspect-[16/10] rounded-md border-[7px] border-current bg-white/10"></div>
              <div class="mx-auto h-4 w-12 bg-current/25"></div>
              <div class="mx-auto h-3 w-24 rounded-pill bg-current/25"></div>
            </div>
          )}
          {categoryKey.includes('projector') && (
            <div class="w-[68%]">
              <div class="h-20 rounded-lg border-[7px] border-current bg-white/10"></div>
              <div class="mx-auto mt-3 h-3 w-24 rounded-pill bg-current/25"></div>
            </div>
          )}
          {categoryKey.includes('internet') && (
            <div class="relative">
              <div class="size-24 rounded-full border-[7px] border-current bg-white/10"></div>
              <div class="absolute -right-8 top-2 size-16 rounded-full border-[4px] border-current opacity-30"></div>
              <div class="absolute -right-14 top-0 size-24 rounded-full border-[4px] border-current opacity-20"></div>
            </div>
          )}
          {!categoryKey.includes('smartphone') && !categoryKey.includes('printer') && !categoryKey.includes('desktop') && !categoryKey.includes('storage') && !categoryKey.includes('monitor') && !categoryKey.includes('projector') && !categoryKey.includes('internet') && (
            <div class="w-[76%]">
              <div class="aspect-[16/10] rounded-md border-[7px] border-current bg-white/10"></div>
              <div class="mx-auto h-4 w-[86%] rounded-b-md bg-current/25"></div>
            </div>
          )}
        </div>
      )}
    </div>
  </a>

  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <div class="flex flex-wrap items-center gap-2">
      <Badge variant={product.inStock ? 'success' : 'neutral'}>{product.inStock ? 'In stock' : 'Check availability'}</Badge>
      {product.featured && <Badge variant="primary">Featured</Badge>}
      {product.condition && <Badge variant="neutral">{product.condition === 'Refurbished' ? 'Ex-UK' : product.condition}</Badge>}
    </div>

    <p class="mt-4 text-label-xs uppercase text-on-surface-variant">{categoryLabel}</p>
    <h3 class="mt-2 line-clamp-3 text-title-md text-on-surface">
      <a href={productHref} class="hover:text-ses-accent">{product.name}</a>
    </h3>
    {product.brand && <p class="mt-1 text-body-sm text-on-surface-variant">{product.brand}</p>}
    {visibleSpecs.length > 0 && (
      <dl class="mt-4 grid gap-2 border-t border-ses-line pt-4">
        {visibleSpecs.map((spec) => (
          <div class="flex items-start justify-between gap-3 text-body-sm">
            <dt class="shrink-0 text-on-surface-variant">{spec.label}</dt>
            <dd class="text-right text-on-surface">{spec.value}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="mt-auto pt-5">
      <div>
        <p class="text-headline-lg text-on-surface">{formatProductPrice(product.price)}</p>
        {product.price.compareAtAmount && (
          <p class="text-body-sm text-on-surface-variant line-through">
            {formatProductPrice({ amount: product.price.compareAtAmount, currency: product.price.currency })}
          </p>
        )}
      </div>
    </div>

    <div class="mt-5 grid gap-2">
      <button
        type="button"
        class="inline-flex min-h-11 items-center justify-center rounded-control bg-primary px-3 text-label-md font-semibold text-on-primary shadow-xs transition hover:-translate-y-0.5 hover:bg-primary-container"
        data-cart-add
        data-cart-product={JSON.stringify(productSummary)}
        aria-label={`Add ${product.name} to cart`}
      >
        ADD TO CART
      </button>
      <Button href={productHref} variant="secondary" size="sm" class="w-full" ariaLabel={`View ${product.name}`}>
        {ctaLabel}
      </Button>
    </div>
  </div>
</article>
