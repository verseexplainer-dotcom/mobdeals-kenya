---
import { classNames } from '@lib/utils/classNames';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  icon?: string;
  href?: string;
  class?: string;
}

const { title, description, eyebrow, icon, href, class: className } = Astro.props;

const content = (
  <>
    <div class="flex items-center justify-between gap-4">
      {eyebrow && <p class="text-label-xs uppercase text-ses-accent">{eyebrow}</p>}
      {icon && <span class="text-headline-sm text-tertiary" aria-hidden="true">{icon}</span>}
    </div>
    <h3 class="mt-5 text-headline-lg text-on-surface">{title}</h3>
    <p class="mt-3 text-body-sm text-on-surface-variant">{description}</p>
  </>
);
---

{
  href ? (
    <a href={href} class={classNames('premium-card-interactive block p-5 sm:p-6', className)}>
      {content}
    </a>
  ) : (
    <article class={classNames('premium-card p-5 sm:p-6', className)}>
      {content}
    </article>
  )
}
