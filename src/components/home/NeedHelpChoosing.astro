---
import Button from '@components/ui/Button.astro';
import Section from '@components/ui/Section.astro';
import { siteConfig } from '@config/site';

const message = encodeURIComponent('Hello MobDeals Kenya, I need help choosing a product. My budget and requirements are:');
---

<Section class="relative overflow-hidden bg-primary" containerSize="xl" ariaLabelledby="need-help-title">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_82%_30%,rgba(56,189,248,0.42),transparent_28rem),linear-gradient(120deg,rgba(2,6,23,0.2),transparent_60%)]" aria-hidden="true"></div>
  <div class="relative grid gap-8 py-2 lg:grid-cols-[1fr_auto] lg:items-center" data-home-reveal>
    <div>
      <p class="text-label-xs uppercase text-cyan-100">A human shortlist, not another filter</p>
      <h2 id="need-help-title" class="mt-3 max-w-3xl font-display text-headline-xl text-white sm:text-display-lg-mobile">Not Sure What Fits Your Budget?</h2>
      <p class="mt-4 max-w-3xl text-body-md text-blue-50/85">
        Tell us how you will use it and what you want to spend. Our Nairobi team will help you compare suitable options from the live catalogue.
      </p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
      <Button href={`https://wa.me/${siteConfig.whatsappNumber}?text=${message}`} target="_blank" variant="whatsapp" size="lg">
        TALK TO US ON WHATSAPP
      </Button>
      <Button href="/business" variant="secondary" size="lg">REQUEST A BUSINESS QUOTE</Button>
    </div>
  </div>
</Section>
