---
import BaseLayout from '@layouts/BaseLayout.astro';
import {
  BrandCarousel,
  CategoryScroller,
  FeaturedProducts,
  HomeHeroSlider,
  NeedHelpChoosing,
  TrustBar
} from '@components/home';
import {
  featuredBrands,
  featuredProducts,
  heroSlides,
  homeCategories,
  trustItems
} from '@data/homepage';
---

<BaseLayout
  mainClass="overflow-hidden"
  seo={{
    title: 'Electronics in Nairobi',
    description: 'Shop laptops, printers, monitors, tablets and electronics from MobDeals Kenya. Nairobi store, warranty support and countrywide delivery.'
  }}
>
  <HomeHeroSlider slides={heroSlides} />
  <TrustBar items={trustItems} />
  <CategoryScroller categories={homeCategories} />
  <FeaturedProducts products={featuredProducts} />
  <BrandCarousel brands={featuredBrands} />
  <NeedHelpChoosing />
</BaseLayout>

<script>
  import { gsap } from 'gsap';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    const activeSlide = document.querySelector<HTMLElement>('[data-hero-slide][data-active="true"]');
    const heroCopy = activeSlide?.querySelector<HTMLElement>('[data-hero-copy]');
    const heroImage = activeSlide?.querySelector<HTMLElement>('[data-hero-image]');

    if (heroCopy) {
      gsap.from(heroCopy.children, {
        opacity: 0,
        y: 24,
        duration: 0.65,
        stagger: 0.08,
        ease: 'power2.out',
        clearProps: 'all'
      });
    }

    if (heroImage) {
      gsap.from(heroImage, {
        scale: 1.045,
        duration: 1.4,
        ease: 'power2.out',
        clearProps: 'transform'
      });
    }

    const reveals = document.querySelectorAll<HTMLElement>('[data-home-reveal]');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        gsap.from(entry.target, {
          opacity: 0,
          y: 22,
          duration: 0.6,
          ease: 'power2.out',
          clearProps: 'all'
        });
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12 });

    reveals.forEach((element) => observer.observe(element));
  }
</script>
