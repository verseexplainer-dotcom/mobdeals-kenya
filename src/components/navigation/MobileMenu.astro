---
import { categoryNavigation, supportNavigation } from '@config/navigation';
import SearchBar from './SearchBar.astro';
---

<details class="group lg:hidden">
  <summary class="flex size-10 cursor-pointer list-none items-center justify-center rounded-pill border border-ses-line bg-surface-container-lowest text-on-surface shadow-xs transition duration-200 hover:bg-surface-container-low focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ses-accent" aria-label="Open menu">
    <span class="text-headline-sm group-open:hidden" aria-hidden="true">☰</span>
    <span class="hidden text-headline-sm group-open:inline" aria-hidden="true">×</span>
  </summary>

  <div class="fixed inset-x-0 top-[4.5rem] z-50 max-h-[calc(100svh-4.5rem)] overflow-y-auto border-y border-ses-line bg-background/95 p-4 shadow-ambient backdrop-blur group-open:animate-fade-up">
    <SearchBar />

    <nav aria-label="Mobile product categories" class="mt-5">
      <p class="px-1 text-label-xs uppercase text-on-surface-variant">Shop categories</p>
      <div class="mt-3 grid gap-2">
        {categoryNavigation.map((category) => (
          <details class="rounded-card border border-ses-line bg-surface-container-lowest p-3">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-label-md text-on-surface">
              {category.label}
              <span aria-hidden="true">⌄</span>
            </summary>
            {category.description && <p class="mt-2 text-body-sm text-on-surface-variant">{category.description}</p>}
            {category.links && (
              <ul class="mt-3 grid gap-2 border-t border-ses-line pt-3">
                {category.links.map((link) => (
                  <li>
                    <a href={link.href} class="block rounded-pill px-3 py-2 text-body-sm text-on-surface-variant hover:bg-surface-container-low hover:text-ses-accent">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </details>
        ))}
      </div>
    </nav>

    <nav aria-label="Mobile support" class="mt-6 border-t border-ses-line pt-5">
      <p class="px-1 text-label-xs uppercase text-on-surface-variant">Support</p>
      <div class="mt-3 grid grid-cols-2 gap-2">
        {supportNavigation.map((item) => (
          <a href={item.href} class="rounded-card border border-ses-line bg-surface-container-lowest px-3 py-3 text-body-sm text-on-surface transition duration-200 hover:border-primary-fixed-dim hover:text-ses-accent">
            {item.label}
          </a>
        ))}
      </div>
    </nav>
  </div>
</details>
