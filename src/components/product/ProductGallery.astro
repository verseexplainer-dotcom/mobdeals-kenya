---
import type { Product } from '@lib/products';
import { usableProductImages } from '@lib/products/images';
import ProductImage from './ProductImage.astro';
interface Props { product: Product; }
const { product } = Astro.props;
const images = usableProductImages(product.images);
---
<div class="space-y-4" data-product-gallery>
  <div class="relative aspect-square overflow-hidden rounded-card-lg border border-ses-line bg-surface-container-lowest">
    <ProductImage image={images[0]} category={product.category} priority gallery />
  </div>
  {images.length > 1 && (
    <div class="flex snap-x gap-3 overflow-x-auto pb-2" aria-label="Product images">
      {images.map((image, index) => (
        <button type="button" class="aspect-square w-20 shrink-0 snap-start overflow-hidden rounded-lg border border-ses-line bg-surface-container-lowest aria-[current=true]:border-secondary" aria-label={`Show image ${index + 1} of ${images.length}`} aria-current={index === 0 ? 'true' : 'false'} data-gallery-thumbnail data-image-src={image.src} data-image-alt={image.alt}>
          <img src={image.src} alt="" width={image.width ?? 800} height={image.height ?? 800} loading="lazy" decoding="async" class="size-full object-contain p-3" />
        </button>
      ))}
    </div>
  )}
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-product-gallery]').forEach((gallery) => {
    const mainImage = gallery.querySelector<HTMLImageElement>('[data-gallery-main]');
    const frame = gallery.querySelector<HTMLElement>('[data-product-image]');
    const thumbnails = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumbnail]'));
    thumbnails.forEach((thumbnail) => {
      const preview = thumbnail.querySelector('img');
      const unavailable = () => {
        thumbnail.disabled = true;
        thumbnail.setAttribute('aria-label', 'Image unavailable');
        preview?.style.setProperty('visibility', 'hidden');
      };
      preview?.addEventListener('error', unavailable);
      if (preview?.complete && !preview.naturalWidth) unavailable();
      thumbnail.addEventListener('click', () => {
        if (!mainImage || !frame || !thumbnail.dataset.imageSrc) return;
        frame.dataset.state = 'exact';
        mainImage.alt = thumbnail.dataset.imageAlt ?? '';
        mainImage.src = thumbnail.dataset.imageSrc;
        thumbnails.forEach((item) => item.setAttribute('aria-current', String(item === thumbnail)));
      });
    });
  });
</script>
