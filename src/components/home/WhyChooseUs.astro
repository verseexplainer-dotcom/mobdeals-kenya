---
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import type { WhyChooseItem } from '@data/homepage';

interface Props {
  items: WhyChooseItem[];
}

const { items } = Astro.props;
---

<Section containerSize="xl" ariaLabelledby="why-choose-title">
  <div class="grid gap-10 lg:grid-cols-[0.8fr_1fr] lg:items-start">
    <SectionHeading
      id="why-choose-title"
      eyebrow="Why choose MobDeals"
      title="Premium, practical, and built around the buyer."
      description="The homepage keeps the route from browsing to confident enquiry short, clear, and locally relevant."
    />

    <div class="divide-y divide-ses-line border-y border-ses-line">
      {items.map((item) => (
        <article class="grid gap-4 py-6 sm:grid-cols-[9rem_1fr] sm:gap-8">
          <p class="text-label-xs uppercase text-ses-accent">{item.label}</p>
          <div>
            <h3 class="text-title-md text-on-surface">{item.title}</h3>
            <p class="mt-2 text-body-sm text-on-surface-variant">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</Section>
