---
import ProductCard from '@components/product/ProductCard.astro';
import Breadcrumbs from '@components/navigation/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import Grid from '@components/ui/Grid.astro';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getAllProducts, productCategories } from '@data/products';
import { getCategoryPresentation } from '@config/catalog';
import { siteConfig } from '@config/site';
import { createItemListSchema, stringifyJsonLd } from '@lib/seo';

const products = getAllProducts();
const initialProductCount = 24;
const categoryCounts = new Map(productCategories.map((category) => [category.slug, products.filter((product) => product.category === category.slug).length]));
const itemListSchema = stringifyJsonLd(createItemListSchema(products, '/shop'));
const helpMessage = encodeURIComponent('Hello MobDeals Kenya, I need help choosing a product. My budget and requirements are:');
---

<BaseLayout
  seo={{
    title: 'Shop Electronics',
    description: 'Browse laptops, printers, monitors, tablets, projectors, software, UPS systems and other electronics available from MobDeals.',
    pathname: '/shop'
  }}
>
  <script slot="head" type="application/ld+json" set:html={itemListSchema} />

  <Section class="bg-surface-container-low/40" containerSize="xl" spacing="sm">
    <Breadcrumbs items={[{ label: 'Shop' }]} />
    <div class="mt-8 max-w-4xl">
      <Badge variant="accent" size="md">MobDeals Kenya</Badge>
      <h1 class="mt-5 font-display text-display-lg-mobile text-on-surface sm:text-headline-xl">Shop Electronics</h1>
      <p class="mt-5 max-w-3xl text-body-lg text-on-surface-variant">
        Browse laptops, printers, monitors, tablets, projectors, software, UPS systems and other electronics available from MobDeals.
      </p>
    </div>
  </Section>

  <Section containerSize="xl" spacing="sm" ariaLabelledby="shop-categories-title">
    <SectionHeading id="shop-categories-title" eyebrow="Browse" title="Shop by Category" />
    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4 2xl:grid-cols-7">
      {productCategories.map((category) => {
        const presentation = getCategoryPresentation(category.slug);
        return (
          <a href={`/category/${category.slug}`} class="group rounded-card border border-ses-line bg-surface-container-lowest/72 p-4 transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-primary-fixed-dim">
            <p class="text-label-xs uppercase text-ses-accent">{presentation.eyebrow}</p>
            <h2 class="mt-3 text-title-md text-on-surface">{category.label}</h2>
            <p class="mt-2 text-body-sm text-on-surface-variant">{categoryCounts.get(category.slug)} products</p>
          </a>
        );
      })}
    </div>
  </Section>

  <Section class="bg-surface-container-low/35" containerSize="xl" spacing="sm" ariaLabelledby="all-products-title">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading id="all-products-title" eyebrow="Shop" title="All Products" />
      <p class="text-body-sm text-on-surface-variant" data-shop-progress>Showing {Math.min(initialProductCount, products.length)} of {products.length}</p>
    </div>

    {products.length > 0 ? (
      <>
        <Grid columns="products" gap="md" class="mt-8" data-shop-grid>
          {products.slice(0, initialProductCount).map((product) => <ProductCard product={product} />)}
        </Grid>
        <div hidden aria-hidden="true">
          {products.slice(initialProductCount).map((product) => (
            <template data-shop-product-template>
              <ProductCard product={product} />
            </template>
          ))}
        </div>
        {products.length > initialProductCount && (
          <div class="mt-10 flex justify-center">
            <button type="button" class="min-h-12 rounded-control border border-ses-line bg-surface-container-lowest px-6 text-label-md text-on-surface hover:border-tertiary hover:text-tertiary" data-shop-load-more>
              LOAD MORE
            </button>
          </div>
        )}
      </>
    ) : (
      <div class="mt-8 rounded-card border border-ses-line bg-surface-container-lowest/70 p-8">
        <h2 class="text-title-md text-on-surface">No products available</h2>
        <p class="mt-2 text-body-md text-on-surface-variant">Contact our team for help finding an alternative.</p>
      </div>
    )}
  </Section>

  <Section containerSize="lg" spacing="sm">
    <div class="rounded-card-lg border border-ses-line bg-primary p-8 text-on-primary sm:p-10">
      <p class="text-label-xs uppercase">Product Support</p>
      <h2 class="mt-3 max-w-2xl font-display text-headline-xl">Need Help Choosing?</h2>
      <p class="mt-4 max-w-2xl text-body-md text-on-primary-container">Tell us what you need, your budget and how you plan to use it.</p>
      <Button href={`https://wa.me/${siteConfig.whatsappNumber}?text=${helpMessage}`} target="_blank" variant="whatsapp" class="mt-6">WHATSAPP US</Button>
    </div>
  </Section>
</BaseLayout>

<script define:vars={{ initialProductCount }}>
  const shopGrid = document.querySelector('[data-shop-grid]');
  const shopTemplates = Array.from(document.querySelectorAll('template[data-shop-product-template]'));
  const loadMoreButton = document.querySelector('[data-shop-load-more]');
  const progress = document.querySelector('[data-shop-progress]');
  let loadedTemplates = 0;

  loadMoreButton?.addEventListener('click', () => {
    const nextTemplates = shopTemplates.slice(loadedTemplates, loadedTemplates + initialProductCount);
    nextTemplates.forEach((template) => shopGrid?.append(template.content.cloneNode(true)));
    loadedTemplates += nextTemplates.length;
    const visible = initialProductCount + loadedTemplates;
    if (progress) progress.textContent = `Showing ${visible} of ${initialProductCount + shopTemplates.length}`;
    if (loadedTemplates >= shopTemplates.length) loadMoreButton.setAttribute('hidden', '');
  });
</script>
