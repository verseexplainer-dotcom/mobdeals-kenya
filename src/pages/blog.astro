---
import { getCollection } from 'astro:content';
import Breadcrumbs from '@components/navigation/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import BaseLayout from '@layouts/BaseLayout.astro';

const guides = (await getCollection('guides'))
  .filter((guide) => !guide.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout
  seo={{
    title: 'Buying Guides',
    description: 'MobDeals guides for comparing laptops, printers, warranty, specifications and running costs.',
    pathname: '/blog'
  }}
>
  <Section class="bg-surface-container-low/40" containerSize="xl" spacing="sm">
    <Breadcrumbs items={[{ label: 'Blog' }]} />
    <div class="mt-10 max-w-4xl">
      <Badge variant="accent" size="md">BUYING GUIDES</Badge>
      <h1 class="mt-5 font-display text-display-lg-mobile text-on-surface sm:text-headline-xl">
        Useful Information Before You Buy
      </h1>
      <p class="mt-5 max-w-2xl text-body-lg text-on-surface-variant">
        Compare specifications, condition, warranty and running costs before choosing equipment.
      </p>
    </div>
  </Section>

  <Section containerSize="xl" spacing="sm">
    <SectionHeading eyebrow="Latest" title="Buying Guides" />
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {guides.map((guide) => (
        <article class="rounded-card border border-ses-line bg-surface-container-lowest p-5">
          <p class="text-label-xs uppercase text-ses-accent">
            {guide.data.publishedAt.toLocaleDateString('en-KE', { year: 'numeric', month: 'short', day: 'numeric' })}
          </p>
          <h2 class="mt-3 text-title-lg text-on-surface">
            <a href={`/blog/${guide.id}`} class="hover:text-ses-accent">{guide.data.title}</a>
          </h2>
          <p class="mt-3 text-body-md text-on-surface-variant">{guide.data.description}</p>
        </article>
      ))}
    </div>
  </Section>
</BaseLayout>
