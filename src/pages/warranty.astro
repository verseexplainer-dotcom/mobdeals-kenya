---
import Breadcrumbs from '@components/navigation/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import Section from '@components/ui/Section.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { siteConfig } from '@config/site';

const warrantyMessage = encodeURIComponent('Hello MobDeals Kenya, please confirm the warranty for this product:');
const warrantySections = [
  ['Brand New Products', 'Brand-new products may include manufacturer, distributor or supplier warranty depending on the item.'],
  ['Refurbished & Ex-UK Products', 'Shop warranty terms for refurbished products vary by item. Confirm the applicable warranty period before payment.'],
  ['Batteries & Accessories', 'For refurbished devices, battery condition, cosmetic condition and included accessories may vary between units. These details can be confirmed before purchase.']
];
---

<BaseLayout seo={{ title: 'Warranty Information', description: 'Warranty coverage depends on the product, condition and applicable supplier or manufacturer terms.', pathname: '/warranty' }}>
  <Section class="bg-surface-container-low/40" containerSize="xl" spacing="sm">
    <Breadcrumbs items={[{ label: 'Warranty' }]} />
    <div class="mt-8 max-w-4xl">
      <Badge variant="accent" size="md">PURCHASE SUPPORT</Badge>
      <h1 class="mt-5 font-display text-display-lg-mobile text-on-surface sm:text-headline-xl">Warranty Information</h1>
      <p class="mt-5 max-w-3xl text-body-lg text-on-surface-variant">Warranty coverage depends on the product, condition and applicable supplier or manufacturer terms. The warranty applicable to an item is shown on its product page or confirmed before payment.</p>
    </div>
  </Section>

  <Section containerSize="xl" spacing="sm">
    <div class="divide-y divide-ses-line border-y border-ses-line">
      {warrantySections.map(([title, text]) => (
        <article class="grid gap-3 py-6 md:grid-cols-[0.6fr_1fr] md:gap-8">
          <h2 class="text-title-md text-on-surface">{title}</h2>
          <p class="text-body-md text-on-surface-variant">{text}</p>
        </article>
      ))}
    </div>

    <div class="mt-10 rounded-card-lg border border-ses-line bg-primary p-8 text-on-primary">
      <h2 class="font-display text-headline-lg">Need to Confirm a Warranty?</h2>
      <p class="mt-4 max-w-2xl text-body-md text-on-primary-container">Send us the product name or link and our team will confirm the warranty applicable to that item.</p>
      <Button href={`https://wa.me/${siteConfig.whatsappNumber}?text=${warrantyMessage}`} target="_blank" variant="whatsapp" class="mt-6">ASK ON WHATSAPP</Button>
    </div>
  </Section>
</BaseLayout>
