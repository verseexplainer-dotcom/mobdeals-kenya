---
import { classNames } from '@lib/utils/classNames';

interface Props {
  class?: string;
  placeholder?: string;
}

const {
  class: className,
  placeholder = 'Search laptops, phones, printers...'
} = Astro.props;
---

<form action="/search" method="get" role="search" class={classNames('relative w-full', className)}>
  <label for="site-search" class="sr-only">Search products</label>
  <input
    id="site-search"
    name="q"
    type="search"
    placeholder={placeholder}
    autocomplete="off"
    class="h-11 w-full rounded-control border border-ses-line bg-surface-container-lowest px-4 pr-11 text-body-sm text-on-surface shadow-xs transition duration-200 ease-standard placeholder:text-on-surface-variant focus:border-ses-accent focus:outline-none focus:ring-2 focus:ring-ses-accent/10"
  />
  <button
    type="submit"
    class="absolute right-1.5 top-1/2 flex size-8 -translate-y-1/2 items-center justify-center rounded-pill text-on-surface-variant transition duration-200 hover:bg-surface-container-low hover:text-ses-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ses-accent"
    aria-label="Submit search"
  >
    <span aria-hidden="true">⌕</span>
  </button>
</form>
