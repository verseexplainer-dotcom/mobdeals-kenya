---
import type { ProductImage } from '@lib/products';
import { categoryImage, usableProductImages } from '@lib/products/images';

interface Props {
  image?: ProductImage;
  category: string;
  priority?: boolean;
  gallery?: boolean;
}
const { image, category, priority = false, gallery = false } = Astro.props;
const fallback = categoryImage(category);
const exact = image && usableProductImages([image])[0];
const display = exact || fallback;
---
<div class="product-image relative size-full" data-product-image data-state={exact ? 'exact' : 'representative'}>
  <img src={display.src} alt={display.alt} width={display.width ?? 800} height={display.height ?? 800}
    srcset={!exact ? `${fallback.src.replace('.webp', '-400.webp')} 400w, ${fallback.src} 800w` : undefined}
    sizes={gallery ? '(max-width: 768px) 100vw, 50vw' : '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 320px'}
    loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async"
    data-product-photo data-gallery-main={gallery || undefined}
    data-fallback-src={fallback.src} data-fallback-alt={fallback.alt}
    class="size-full object-contain p-3 sm:p-5" />
  <span class="image-unavailable absolute inset-0 items-center justify-center p-6 text-center text-body-sm text-on-surface-variant">Photo unavailable. Ask us for a product photo.</span>
  <span class="image-caption absolute inset-x-2 bottom-2 rounded-sm bg-background px-2 py-1 text-center text-xs text-on-background">Representative image · exact model may differ</span>
</div>
<style>
  .image-caption, .image-unavailable { display: none; }
  [data-state='representative'] .image-caption { display: block; }
  [data-state='unavailable'] .image-unavailable { display: flex; }
  [data-state='unavailable'] img { visibility: hidden; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-product-image]').forEach((frame) => {
    const photo = frame.querySelector<HTMLImageElement>('[data-product-photo]');
    if (!photo) return;
    const recover = () => {
      const fallback = photo.dataset.fallbackSrc;
      if (!fallback || photo.getAttribute('src') === fallback) {
        frame.dataset.state = 'unavailable';
        photo.alt = '';
        return;
      }
      frame.dataset.state = 'representative';
      photo.alt = photo.dataset.fallbackAlt ?? 'Category illustration';
      photo.removeAttribute('srcset');
      photo.src = fallback;
    };
    photo.addEventListener('error', recover);
    // Cached errors may happen before this bundled script executes.
    if (photo.complete && photo.naturalWidth === 0) recover();
  });
</script>
