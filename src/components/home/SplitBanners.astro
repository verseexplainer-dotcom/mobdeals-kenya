---
import Button from '@components/ui/Button.astro';
import Section from '@components/ui/Section.astro';
import type { PromoBanner } from '@data/homepage';

interface Props {
  banners: PromoBanner[];
}

const { banners } = Astro.props;
---

<Section containerSize="xl" spacing="lg" ariaLabel="Featured shopping stories">
  <div class="grid gap-5">
    {banners.map((banner, index) => (
      <article class={`grid overflow-hidden rounded-card border border-ses-line ${banner.tone === 'dark' ? 'bg-surface text-on-surface' : 'bg-inverse-surface text-inverse-on-surface'} lg:grid-cols-2`}>
        <div class={`flex min-h-[24rem] items-center justify-center p-8 ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
          {banner.visual === 'laptop' && (
            <div class="w-[min(34rem,100%)] text-current">
              <div class="rounded-card border border-current/15 p-3 shadow-soft">
                <div class="aspect-[16/10] rounded-md bg-current/10 p-5">
                  <div class="h-3 w-24 rounded-pill bg-current/30"></div>
                  <div class="mt-24 h-4 w-2/3 rounded-pill bg-current/25"></div>
                  <div class="mt-3 h-3 w-1/2 rounded-pill bg-current/15"></div>
                </div>
              </div>
              <div class="mx-auto h-5 w-[80%] rounded-b-md bg-current/15"></div>
            </div>
          )}
          {banner.visual === 'phone' && (
            <div class="flex items-end gap-4 text-current">
              <div class="h-72 w-32 rounded-[1.6rem] border-[7px] border-current/70 bg-current/10 shadow-soft"></div>
              <div class="mb-10 h-56 w-24 rounded-[1.35rem] border-[6px] border-current/55 bg-current/10"></div>
              <div class="mb-4 h-24 w-24 rounded-card border border-current/20 bg-current/10"></div>
            </div>
          )}
          {banner.visual === 'printer' && (
            <div class="w-[min(30rem,100%)] text-current">
              <div class="mx-auto h-12 w-4/5 rounded-t-md bg-current/15"></div>
              <div class="rounded-card border border-current/20 bg-current/10 p-5 shadow-soft">
                <div class="h-4 w-24 rounded-pill bg-current/25"></div>
                <div class="mt-10 h-28 rounded-md bg-current/10"></div>
              </div>
            </div>
          )}
        </div>

        <div class="flex min-h-[24rem] flex-col justify-center p-6 sm:p-8 lg:p-12">
          <p class={`text-label-xs uppercase ${banner.tone === 'dark' ? 'text-tertiary' : 'text-primary'}`}>{banner.eyebrow}</p>
          <h2 class="mt-4 max-w-[36rem] text-headline-xl font-display text-balance sm:text-display-lg-mobile">
            {banner.title}
          </h2>
          <p class={`mt-5 max-w-[32rem] text-body-md text-pretty ${banner.tone === 'dark' ? 'text-on-surface-variant' : 'text-slate-600'}`}>
            {banner.description}
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Button href={banner.href} variant={banner.tone === 'dark' ? 'secondary' : 'blue'} size="lg" class="w-fit">
              {banner.ctaLabel}
            </Button>
            {banner.secondaryCta && (
              <Button href={banner.secondaryCta.href} variant="secondary" size="lg" class="w-fit">
                {banner.secondaryCta.label}
              </Button>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</Section>
