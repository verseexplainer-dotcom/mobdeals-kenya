---
import '../styles/marketing.css';
import { siteConfig } from '@config/site';
import { homeCategories, featuredProducts } from '@data/homepage';
import { formatProductPrice } from '@lib/products';
import { stringifyJsonLd } from '@lib/seo';
import ProductImage from '@components/product/ProductImage.astro';
import ScrollFilm from '../components/ScrollFilm.astro';
import { homeMedia } from '@data/home-media';

const shop = siteConfig.siteUrl;
const chat = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hello MobDeals Kenya, please help me choose the right technology.')}`;
const quote = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hello MobDeals Kenya, I would like a quotation for business or office equipment.')}`;
const hero = homeMedia.student.desktopSrc;
const mobileHero = homeMedia.student.mobileSrc;
const film = homeMedia.film;
const title = 'MobDeals Kenya | Technology for your next chapter';
const description = 'Find the right laptop, printer, monitor and everyday technology with MobDeals Kenya. Visit us in Nairobi CBD or talk to our team on WhatsApp.';
const schema = {
  '@context': 'https://schema.org', '@type': 'ElectronicsStore',
  name: siteConfig.name, url: `${siteConfig.marketingUrl}/`,
  logo: `${siteConfig.marketingUrl}${siteConfig.logo}`, telephone: siteConfig.phone,
  email: siteConfig.email, address: { '@type': 'PostalAddress', streetAddress: 'Moi Avenue', addressLocality: 'Nairobi', addressCountry: 'KE' }
};
const trust = [
  ['01', 'A real Nairobi store', 'Visit us on Moi Avenue, Nairobi CBD.', `${shop}/store`],
  ['02', 'Know your warranty', 'Confirm the terms for your item before purchase.', `${shop}/warranty`],
  ['03', 'Delivery across Kenya', 'We confirm the route, timing and fee with you.', `${shop}/delivery`],
  ['04', 'A person to help', 'Get advice directly from our team on WhatsApp.', chat]
];
---
<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#102A2A" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href="https://mobdeals.co.ke/" />
    <link rel="icon" href="/favicon.ico" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" /><meta property="og:locale" content="en_KE" />
    <meta property="og:site_name" content={siteConfig.name} /><meta property="og:title" content={title} />
    <meta property="og:description" content={description} /><meta property="og:url" content="https://mobdeals.co.ke/" />
    <meta property="og:image" content={`${siteConfig.marketingUrl}${hero}`} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} /><meta name="twitter:image" content={`${siteConfig.marketingUrl}${hero}`} />
    <script is:inline type="application/ld+json" set:html={stringifyJsonLd(schema)} />
  </head>
  <body class="marketing">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <ScrollFilm src={film} poster={hero} mobilePoster={mobileHero} />
    <header class="marketing-header">
      <a class="brand" href="/" aria-label="MobDeals home"><img src={siteConfig.logo} alt="MobDeals" width="176" height="43" /></a>
      <nav aria-label="Main navigation"><a href="#explore">Explore</a><a href="#business">For business</a><a href="#contact">Find us</a></nav>
      <a href={shop} class="cta header-cta">Shop MobDeals <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main-content">
      <section class="marketing-hero" aria-labelledby="hero-title">
        <div class="wrap hero-content">
          <p class="eyebrow">Nairobi roots. New possibilities.</p>
          <h1 id="hero-title"><span class="hero-brand">MobDeals.</span>For your<br />next chapter.</h1>
          <p class="hero-description">Your first laptop. A better workspace. A business ready to grow. Find the technology to take you there.</p>
          <div class="actions"><a href={shop} class="cta">Shop MobDeals <span aria-hidden="true">↗</span></a><a href={chat} class="text-link">Let’s find your fit <span aria-hidden="true">→</span></a></div>
        </div>
        <div class="hero-bottom wrap"><span>Work. Learn. Make things happen.</span><a href="#confidence">Discover MobDeals ↓</a></div>
      </section>

      <section id="confidence" class="trust-section solid" aria-label="Buy with confidence">
        <div class="wrap trust-grid">{trust.map(([number, heading, text, href]) => <a href={href} class="trust-item"><span class="index">{number}</span><h2>{heading}</h2><p>{text}</p><span aria-hidden="true">↗</span></a>)}</div>
      </section>

      <section id="explore" class="marketing-section light-section" aria-labelledby="explore-title">
        <div class="wrap">
          <div class="section-heading"><div><p class="eyebrow">Find your starting point</p><h2 id="explore-title">What’s next<br />for you?</h2></div><p>From the lecture hall to the meeting room.<br />Explore technology that fits your day.</p></div>
          <div class="category-discovery">{homeCategories.map((category, index) => <a class="category-link" href={`${shop}${category.href}`}><div class="category-visual"><img src={category.image.src} alt={category.image.alt} width="800" height="800" loading="lazy" decoding="async" /></div><div class="category-title"><span class="index">0{index + 1}</span><h3>{category.label}</h3><span aria-hidden="true">↗</span></div><p>{category.description}</p></a>)}</div>
        </div>
      </section>

      <section class="marketing-section solid" aria-labelledby="deals-title">
        <div class="wrap">
          <div class="section-heading"><div><p class="eyebrow">A few places to begin</p><h2 id="deals-title">Meet your next<br />everyday essential.</h2></div><a class="text-link" href={`${shop}/shop`}>Explore all deals ↗</a></div>
          <div class="selected-deals">{featuredProducts.slice(0, 4).map((product) => <article class="deal"><a href={`${shop}/products/${product.slug}`} aria-label={`View ${product.name}`} class="deal-photo"><ProductImage image={product.images[0]} category={product.category} /></a><p class="eyebrow">{product.condition === 'Refurbished' ? 'Ex-UK' : product.condition} · {product.brand}</p><h3><a href={`${shop}/products/${product.slug}`}>{product.name}</a></h3><p class="deal-price">{formatProductPrice(product.price)}</p><a class="text-link" href={`${shop}/products/${product.slug}`}>View in shop ↗</a></article>)}</div>
          <p class="availability-note">Confirm current price, availability and warranty with our team before payment.</p>
        </div>
      </section>

      <section class="marketing-section light-section" aria-labelledby="steps-title">
        <div class="wrap steps-layout"><div><p class="eyebrow">From a shortlist to your setup</p><h2 id="steps-title">Good advice.<br />A clear next step.</h2><a href={chat} class="cta">Talk to our team ↗</a></div><ol class="steps"><li><span class="index">01</span><div><h3>Find what fits.</h3><p>Browse the shop and compare the specifications, condition and price.</p></div></li><li><span class="index">02</span><div><h3>Let’s confirm the details.</h3><p>Send your selection on WhatsApp. We’ll confirm stock, warranty and the total with you.</p></div></li><li><span class="index">03</span><div><h3>Pick up. Or have it delivered.</h3><p>Agree payment and collection or delivery with our team before dispatch.</p></div></li></ol></div>
      </section>

      <section id="business" class="business-section" aria-labelledby="business-title">
        <div class="wrap"><p class="eyebrow">For teams with things to do</p><h2 id="business-title">Better tools.<br />Bigger possibilities.</h2><p>Equip your office with laptops, monitors, printers and backup power. Tell us what your team needs, and we’ll help build your quotation.</p><div class="actions"><a class="cta" href={quote}>Request a business quote ↗</a><a class="text-link" href={`${shop}/business`}>Explore office technology →</a></div></div>
      </section>

      <section id="contact" class="marketing-section solid" aria-labelledby="contact-title">
        <div class="wrap contact-layout"><div><p class="eyebrow">Online. And right here.</p><h2 id="contact-title">Let’s talk<br />in Nairobi.</h2><p>Come with a shortlist. Leave with a clearer idea.</p></div><div class="contact-details"><div><span class="eyebrow">Visit MobDeals</span><address>{siteConfig.address}</address><p>{siteConfig.openingHours}</p><a class="text-link" href={siteConfig.directionsUrl} target="_blank" rel="noreferrer">Get directions ↗</a></div><div><span class="eyebrow">Call or WhatsApp</span><a class="contact-phone" href={siteConfig.phoneHref}>{siteConfig.phone}</a><a class="text-link" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></div></div></div>
      </section>

      <section class="final-section" aria-labelledby="final-title"><div class="wrap"><p class="eyebrow">Your next chapter starts here</p><h2 id="final-title">Make it<br />MobDeals.</h2><a class="cta" href={shop}>Shop MobDeals <span aria-hidden="true">↗</span></a></div></section>
    </main>
    <footer class="marketing-footer solid"><div class="wrap"><a class="footer-brand" href="/">MobDeals Kenya</a><p>© {new Date().getFullYear()} MobDeals Kenya</p><nav aria-label="Footer navigation"><a href={`${shop}/warranty`}>Warranty</a><a href={`${shop}/delivery`}>Delivery</a><a href={chat}>WhatsApp ↗</a></nav></div></footer>
  </body>
</html>
