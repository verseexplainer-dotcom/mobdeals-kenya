---
import '@styles/global.css';
import { createOrganizationSchema, createSeoMeta, stringifyJsonLd, type SeoInput } from '@lib/seo';
import { siteConfig } from '@config/site';
import Header from '@components/navigation/Header.astro';
import Footer from '@components/navigation/Footer.astro';

interface Props {
  seo?: SeoInput;
  bodyClass?: string;
  mainClass?: string;
  showHeader?: boolean;
  showFooter?: boolean;
}

const {
  seo,
  bodyClass = '',
  mainClass = '',
  showHeader = true,
  showFooter = true
} = Astro.props;

const pathname = Astro.url.pathname;
const meta = createSeoMeta({ pathname, ...seo });
const organizationSchema = stringifyJsonLd(createOrganizationSchema());
---

<!doctype html>
<html lang={siteConfig.locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={meta.themeColor} />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {meta.noIndex && <meta name="robots" content="noindex,nofollow" />}
    {meta.canonical && <link rel="canonical" href={meta.canonical} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={siteConfig.shortName} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:site_name" content={meta.siteName} />
    <meta property="og:locale" content={meta.locale.replace('-', '_')} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:type" content={meta.type} />
    {meta.canonical && <meta property="og:url" content={meta.canonical} />}
    {meta.image && <meta property="og:image" content={meta.image} />}
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:card" content={meta.image ? 'summary_large_image' : 'summary'} />
    {meta.image && <meta name="twitter:image" content={meta.image} />}
    <script is:inline type="application/ld+json" set:html={organizationSchema} />
    <slot name="head" />
  </head>
  <body class={`min-h-screen bg-background text-on-background antialiased ${bodyClass}`}>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-control focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary">
      Skip to content
    </a>
    {showHeader && <Header />}
    <main id="main-content" class={mainClass}>
      <slot />
    </main>
    <a
      href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hello MobDeals Kenya, I need help with a product.')}`}
      target="_blank"
      rel="noreferrer"
      class="fixed bottom-[calc(1.5rem+env(safe-area-inset-bottom))] right-6 z-30 hidden min-h-12 items-center gap-2 rounded-pill bg-whatsapp px-4 text-label-md text-on-secondary shadow-soft hover:bg-whatsapp-dark sm:inline-flex"
      aria-label="Talk to MobDeals on WhatsApp"
    >
      <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
        <path d="M12 2a9.7 9.7 0 0 0-8.4 14.5L2 22l5.7-1.5A9.8 9.8 0 1 0 12 2Zm0 17.8a7.8 7.8 0 0 1-4-1.1l-.3-.2-3.4.9.9-3.3-.2-.4A7.8 7.8 0 1 1 12 19.8Zm4.3-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1-1.4-.7-2.4-1.3-3.3-2.9-.3-.5.3-.5.8-1.5.1-.2 0-.4 0-.5l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.5 3.9 1.7.7 2.4.8 3.3.7 1-.1 1.4-.7 1.6-1.3.2-.6.2-1.1.1-1.2-.1-.2-.2-.2-.4-.3Z"></path>
      </svg>
      <span class="hidden sm:inline">WhatsApp</span>
    </a>
    {showFooter && <Footer />}
  </body>
</html>
