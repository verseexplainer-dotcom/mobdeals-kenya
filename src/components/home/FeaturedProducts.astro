---
import ProductCard from '@components/product/ProductCard.astro';
import Badge from '@components/ui/Badge.astro';
import Grid from '@components/ui/Grid.astro';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import type { ProductSummary } from '@lib/products';

interface Props {
  products: ProductSummary[];
}

const { products } = Astro.props;

const categoryHrefs: Record<string, string> = {
  laptops: '/category/laptops',
  smartphones: '/category/smartphones',
  printers: '/category/printers',
  desktops: '/category/desktops',
  storage: '/category/storage'
};
---

<Section class="bg-surface-container-low" containerSize="xl" ariaLabelledby="featured-products-title">
  <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
    <SectionHeading
      id="featured-products-title"
      eyebrow="Featured products"
      title="Representative picks for common orders."
      description="Common buying paths for business laptops, everyday phones, office printers, and desktop setups."
    />
    <Badge variant="primary" size="md">Popular paths</Badge>
  </div>

  <Grid columns="four" gap="md" class="mt-10">
    {products.map((product, index) => (
      <ProductCard
        product={product}
        href={categoryHrefs[product.category] ?? '/shop'}
        ctaLabel="View options"
        priority={index < 2}
      />
    ))}
  </Grid>
</Section>
