---
import Button from '@components/ui/Button.astro';
import Section from '@components/ui/Section.astro';
import { siteConfig } from '@config/site';

const message = encodeURIComponent('Hello MobDeals Kenya, I need help choosing a product. My budget and requirements are:');
---

<Section class="relative overflow-hidden bg-[#102a2a] text-white" containerSize="xl" ariaLabelledby="need-help-title">
  <div class="pointer-events-none absolute -right-24 -top-28 size-[28rem] rounded-full bg-[#0f766e]/45 blur-3xl" aria-hidden="true"></div>
  <div class="relative grid gap-8 lg:grid-cols-[0.82fr_1fr_0.92fr] lg:items-center" data-home-reveal>
    <div class="relative mx-auto w-full max-w-[18rem] overflow-hidden rounded-[1.5rem] border border-white/15 bg-[#f6f7f3] shadow-ambient lg:mx-0">
      <img src="/images/home/teal-orange-v2/category-laptops.webp" alt="Laptop with a teal and orange display" width="800" height="800" class="aspect-square w-full object-cover" loading="lazy" decoding="async" />
      <span class="absolute bottom-3 left-3 rounded-pill bg-[#102a2a]/90 px-3 py-2 text-[0.65rem] font-bold tracking-[0.12em] text-white uppercase">MobDeals Kenya</span>
    </div>
    <div>
      <p class="text-label-xs uppercase tracking-[0.14em] text-[#ffb17b]">A human shortlist, not another filter</p>
      <h2 id="need-help-title" class="mt-3 max-w-3xl font-display text-headline-xl font-bold text-white sm:text-display-lg-mobile">Ready for your next device?</h2>
      <p class="mt-4 max-w-3xl text-body-md text-white/75">
        Tell us how you will use it and what you want to spend. Our Nairobi team can help you compare suitable options from the catalogue.
      </p>
    </div>
    <div class="rounded-card-lg border border-[#47706a] bg-[#163b3a]/75 p-6 shadow-soft sm:p-7">
      <p class="text-label-xs uppercase tracking-[0.14em] text-[#ffb17b]">Start a conversation</p>
      <h3 class="mt-3 font-display text-xl font-semibold text-white">Let’s find what fits.</h3>
      <p class="mt-2 text-sm leading-6 text-white/70">Get personal help choosing devices for work, school or business.</p>
      <div class="mt-6 flex flex-col gap-3">
        <Button href={`https://wa.me/${siteConfig.whatsappNumber}?text=${message}`} target="_blank" variant="whatsapp" size="lg">
          TALK TO US ON WHATSAPP
        </Button>
        <Button href="/business" variant="secondary" size="lg">REQUEST A BUSINESS QUOTE</Button>
      </div>
    </div>
  </div>
</Section>
