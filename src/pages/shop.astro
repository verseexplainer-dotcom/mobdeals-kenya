---
import ProductCard from '@components/product/ProductCard.astro';
import Breadcrumbs from '@components/navigation/Breadcrumbs.astro';
import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import Grid from '@components/ui/Grid.astro';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getAllProducts, productCategories } from '@data/products';
import { createItemListSchema, stringifyJsonLd } from '@lib/seo';

const products = getAllProducts();
const itemListSchema = stringifyJsonLd(createItemListSchema(products, '/shop'));
---

<BaseLayout
  seo={{
    title: 'Shop Electronics in Nairobi',
    description:
      'Browse laptops, smartphones, desktops, printers, storage, and tech accessories from SES NEXT GEN in Nairobi with clear specs and availability notes.',
    pathname: '/shop'
  }}
>
  <script slot="head" type="application/ld+json" set:html={itemListSchema} />

  <Section class="bg-surface-container-low/40" containerSize="xl" spacing="sm">
    <Breadcrumbs items={[{ label: 'Shop' }]} />
    <div class="mt-10 grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
      <div>
        <Badge variant="accent" size="md">SES NEXT GEN catalog</Badge>
        <h1 class="mt-5 max-w-3xl font-display text-display-lg-mobile text-on-surface sm:text-headline-xl lg:text-display-lg">
          Shop electronics with clear specs before you spend.
        </h1>
        <p class="mt-5 max-w-2xl text-body-lg text-on-surface-variant">
          Compare laptops, phones, printers, desktops, and storage around condition, warranty, availability, and practical Kenya buying needs.
        </p>
      </div>
      <div class="rounded-card border border-ses-line bg-surface-container-lowest/70 p-5">
        <p class="text-label-xs uppercase text-ses-accent">Catalog status</p>
        <dl class="mt-4 grid grid-cols-2 gap-4">
          <div>
            <dt class="text-body-sm text-on-surface-variant">Products</dt>
            <dd class="font-display text-headline-lg text-on-surface">{products.length}</dd>
          </div>
          <div>
            <dt class="text-body-sm text-on-surface-variant">Categories</dt>
            <dd class="font-display text-headline-lg text-on-surface">{productCategories.length}</dd>
          </div>
        </dl>
      </div>
    </div>
  </Section>

  <Section containerSize="xl" spacing="sm" ariaLabelledby="shop-categories-title">
    <SectionHeading
      id="shop-categories-title"
      eyebrow="Shop by category"
      title="Start with the buying path"
      description="Each category page narrows the catalog and gives the product context needed before content updates scale."
    />
    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {productCategories.map((category) => (
        <a href={`/category/${category.slug}`} class="group rounded-card border border-ses-line bg-surface-container-lowest/72 p-4 transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-primary-fixed-dim">
          <p class="text-label-xs uppercase text-ses-accent">{category.eyebrow}</p>
          <h2 class="mt-3 text-title-md text-on-surface">{category.label}</h2>
          <p class="mt-2 text-body-sm text-on-surface-variant">{getAllProducts().filter((product) => product.category === category.slug).length} products</p>
        </a>
      ))}
    </div>
  </Section>

  <Section class="bg-surface-container-low/35" containerSize="xl" spacing="sm" ariaLabelledby="all-products-title">
    <SectionHeading
      id="all-products-title"
      eyebrow="All products"
      title="Current product structure"
      description="Static seed products are ready for page design, SEO, JSON-LD, and later Supabase media updates."
    />
    {products.length > 0 ? (
      <Grid columns="products" gap="md" class="mt-8">
        {products.map((product) => <ProductCard product={product} />)}
      </Grid>
    ) : (
      <div class="mt-8 rounded-card border border-ses-line bg-surface-container-lowest/70 p-8">
        <h2 class="text-title-md text-on-surface">No products available yet</h2>
        <p class="mt-2 text-body-md text-on-surface-variant">Add products to the catalog data source before publishing this listing.</p>
      </div>
    )}
  </Section>

  <Section containerSize="lg" spacing="sm">
    <div class="rounded-card-lg border border-ses-line bg-primary p-8 text-on-primary sm:p-10">
      <p class="text-label-xs uppercase">Need help choosing?</p>
      <h2 class="mt-3 max-w-2xl font-display text-headline-xl">Tell us the work, budget, and preferred brand.</h2>
      <p class="mt-4 max-w-2xl text-body-md text-on-primary-container">
        SES NEXT GEN can help compare condition, specs, warranty, and delivery options before you commit.
      </p>
      <Button href="/contact" variant="secondary" class="mt-6">Talk to support</Button>
    </div>
  </Section>
</BaseLayout>
