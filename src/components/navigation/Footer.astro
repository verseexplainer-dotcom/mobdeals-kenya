---
import { footerNavigation } from '@config/navigation';
import { siteConfig } from '@config/site';
import Container from '@components/ui/Container.astro';
---

<footer class="border-t border-ses-line bg-surface-container-lowest">
  <Container size="xl" class="py-12 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <a href="/" class="inline-flex items-center" aria-label={`${siteConfig.name} home`}>
          <img
            src={siteConfig.logo}
            alt={siteConfig.name}
            width="1200"
            height="292"
            class="h-14 w-auto max-w-[16rem] object-contain"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="mt-4 max-w-[28rem] text-body-sm text-on-surface-variant">
          MobDeals supplies laptops, printers, monitors and other electronics from Nairobi, with support for individual and business orders.
        </p>

        <a href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hello MobDeals Kenya, I need help with a product.')}`} target="_blank" rel="noreferrer" class="mt-5 inline-flex min-h-11 items-center rounded-control bg-whatsapp px-4 text-label-md text-white hover:bg-whatsapp-dark">
          WhatsApp Us
        </a>
      </div>

      <nav aria-label="Footer navigation" class="grid gap-8 sm:grid-cols-2 xl:grid-cols-4">
        {footerNavigation.map((group) => (
          <section>
            <h2 class="text-label-md text-on-surface">{group.title}</h2>
            <ul class="mt-4 grid gap-3">
              {group.links.map((link) => (
                <li>
                  <a href={link.href} class="text-body-sm text-on-surface-variant hover:text-ses-accent">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
        <section>
          <h2 class="text-label-md text-on-surface">Contact</h2>
          <ul class="mt-4 grid gap-3 text-body-sm text-on-surface-variant">
            <li><a href={siteConfig.phoneHref} class="hover:text-ses-accent">{siteConfig.phone}</a></li>
            <li><a href={`mailto:${siteConfig.email}`} class="break-all hover:text-ses-accent">{siteConfig.email}</a></li>
            <li><a href="/store" class="hover:text-ses-accent">{siteConfig.address}</a></li>
          </ul>
        </section>
      </nav>
    </div>

    <div class="mt-10 border-t border-ses-line pt-6 text-body-sm text-on-surface-variant">
      <p>&copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved.</p>
    </div>
  </Container>
</footer>
