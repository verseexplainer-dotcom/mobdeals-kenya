---
import BaseLayout from '@layouts/BaseLayout.astro';
import {
  BrandCarousel,
  CategoryScroller,
  FeaturedProducts,
  HomeHeroSlider,
  NeedHelpChoosing,
  NewsletterCTA,
  SplitBanners,
  TrustBar,
  WhyChooseUs
} from '@components/home';
import {
  featuredBrands,
  featuredProducts,
  heroSlides,
  homeCategories,
  promoBanners,
  trustItems,
  whyChooseItems
} from '@data/homepage';
---

<BaseLayout
  mainClass="overflow-hidden"
  seo={{
    title: 'Electronics in Nairobi',
    description: 'Shop laptops, printers, monitors, tablets and electronics from MobDeals Kenya. Nairobi store, warranty support and countrywide delivery.'
  }}
>
  <HomeHeroSlider slides={heroSlides} />
  <TrustBar items={trustItems} />
  <CategoryScroller categories={homeCategories} />
  <FeaturedProducts products={featuredProducts} />
  <SplitBanners banners={promoBanners} />
  <BrandCarousel brands={featuredBrands} />
  <WhyChooseUs items={whyChooseItems} />
  <NeedHelpChoosing />
  <NewsletterCTA />
</BaseLayout>
